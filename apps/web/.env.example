# Copy to .env.local (never commit .env.local). Values from the Supabase dashboard.
# Project Settings > API. (The app does not use the anon/publishable key.)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Server-side only. Bypasses RLS. Never expose in client code or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
# Connect > Session pooler. Only used by one-off setup scripts, not by the app.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional. When set, every page asks for this code first. Use it on any deployed prototype, because the prototype has no real login.
# Leave unset for local development.
DEMO_ACCESS_CODE=
